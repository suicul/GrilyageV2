# --- Database ---
DATABASE_URL=postgresql://grilyage:grilyage_dev@localhost:5432/grilyage

# --- API ---
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000

# --- Auth (клиенты) ---
JWT_ACCESS_SECRET=change-me-user-access
JWT_REFRESH_SECRET=change-me-user-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Auth (персонал CRM, ОТДЕЛЬНЫЕ секреты) ---
STAFF_JWT_ACCESS_SECRET=change-me-staff-access
STAFF_JWT_REFRESH_SECRET=change-me-staff-refresh

# --- Email (dev: Mailpit; prod: iRedMail SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Грильяж <noreply@grilyazh-omsk.ru>"

# --- Uploads ---
UPLOADS_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000

# --- Yandex Maps (получить ключ: https://developer.tech.yandex.ru/) ---
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

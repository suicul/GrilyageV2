import { NextResponse } from 'next/server';
import type { NextRequest } from 'next/server';

/**
 * Generate a Content Security Policy header with a per-request nonce.
 * Uses strict-dynamic for script trust propagation:
 * - Scripts with the nonce execute
 * - Scripts loaded by trusted scripts also execute (strict-dynamic)
 *
 * Report-only mode is used during transition; switch to enforce by
 * changing the header name to Content-Security-Policy once verified.
 */
export function middleware(request: NextRequest) {
  const nonce = crypto.randomUUID();

  const csp = [
    `default-src 'self'`,
    `script-src 'nonce-${nonce}' 'strict-dynamic' 'https://unpkg.com'`,
    `style-src 'self' 'unsafe-inline' https://fonts.googleapis.com`,
    `font-src 'self' https://fonts.gstatic.com data:`,
    `img-src 'self' data: blob: https://images.unsplash.com https://*.unsplash.com`,
    `frame-src 'self' https://yandex.com https://yandex.ru`,
    `connect-src 'self' https://o4511609450004480.ingest.de.sentry.io wss://grillyage.ru`,
    `form-action 'self'`,
    `frame-ancestors 'none'`,
    `upgrade-insecure-requests`,
  ].join('; ');

  // Clone request headers and set the nonce so page rendering can read it
  const requestHeaders = new Headers(request.headers);
  requestHeaders.set('x-nonce', nonce);

  const response = NextResponse.next({
    request: { headers: requestHeaders },
  });

  // Set CSP as Content-Security-Policy-Report-Only during transition
  // to verify no violations before switching to enforce mode
  response.headers.set('Content-Security-Policy-Report-Only', csp);
  response.headers.set('x-nonce', nonce);

  return response;
}

export const config = {
  matcher: [
    // Apply to all routes except static assets, API rewrites, and Next.js internals
    '/((?!_next/static|_next/image|favicon.ico|api/v1/).*)',
  ],
};

// Грильяж — Prisma schema
// Цены продуктов — rubles + kopecks (для удобства ввода).
// Итоговые суммы заказов — INTEGER КОПЕЙКИ (внутренние расчёты).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum DeliveryMode {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  CASH
  CARD_ON_DELIVERY
}

enum OrderStatus {
  NEW
  CONFIRMED
  COOKING
  DELIVERING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum StaffRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  COURIER
}

enum TransportType {
  WALKING
  CAR
}

enum EmailTokenType {
  VERIFY
  RESET
}

// --- Users (clients) ---

model User {
  id                      String         @id @default(cuid())
  email                   String?  @unique
  phone                   String?
  name                    String
  passwordHash            String?
  emailVerifiedAt         DateTime?
  phoneVerifiedAt         DateTime?
  isActive                Boolean        @default(false)
  activationToken         String?  @unique
  activationTokenExpiresAt DateTime?
  loginAttempts           Int            @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  addresses     Address[]
  pushTokens    PushToken[]
  orders        Order[]
  emailTokens   EmailToken[]
  refreshTokens RefreshToken[]
  consent       UserConsent?
  socialAccounts SocialAccount[]
  calls         CallQueue[]
  chatRooms     ChatRoom[]
}

model SocialAccount {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String   // VK | YANDEX | TELEGRAM | MAX | WHATSAPP | EMAIL
  providerId String   // ID from the provider
  email      String?
  name       String?
  avatarUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([provider, providerId])
  @@index([userId])
  @@index([provider])
}

// --- User Consent (152-ФЗ) ---

model UserConsent {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  privacyAcceptedAt   DateTime @default(now())
  termsAcceptedAt     DateTime @default(now())
  marketingAcceptedAt DateTime?
  dataProcessingAt    DateTime @default(now())
  ip                  String?
  userAgent           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String         @unique
  type      EmailTokenType
  expiresAt DateTime
  createdAt DateTime       @default(now())

  @@index([userId])
}

// --- OTP Codes (phone + email verification) ---

model OtpCode {
  id         String   @id @default(cuid())
  identifier String   // phone number or email
  code       String   // 6-digit code
  type       String   // "PHONE" | "EMAIL"
  purpose    String   // "AUTH" | "VERIFY_EMAIL" | "RESET"
  expiresAt  DateTime
  usedAt     DateTime?
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, purpose])
  @@index([identifier, code])
  @@index([identifier])
}

model RefreshToken {
  id           String     @id @default(cuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffUserId  String?
  staffUser    StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())

  @@index([userId])
  @@index([staffUserId])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  street    String
  house     String
  apartment String?
  comment   String?

  @@index([userId])
}

// --- Staff (CRM) ---

model StaffUser {
  id             String        @id @default(cuid())
  login          String        @unique
  name           String
  passwordHash   String
  role           StaffRole
  active         Boolean       @default(true)
  loginAttempts  Int           @default(0)
  lockedUntil    DateTime?
  totpSecret     String?
  transportType  TransportType @default(WALKING)
  deliveryRadius Int           @default(5)
  lastLatitude   Float?
  lastLongitude  Float?
  lastLocationAt DateTime?
  createdAt      DateTime      @default(now())

  assignedOrders  Order[]           @relation("CourierAssignment")
  refreshTokens   RefreshToken[]
  statusLogs      OrderStatusLog[]
}

// --- Catalog ---

model Category {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  sortOrder Int     @default(0)
  imageUrl  String?
  active    Boolean @default(true)

  subcategories Subcategory[]
}

model Subcategory {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)

  products Product[]

  @@unique([categoryId, slug])
}

model Product {
  id            String      @id @default(cuid())
  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  name          String
  slug          String      @unique
  description   String      @default("")
  priceRubles   Int         @default(0)
  priceKopecks  Int         @default(0)
  weightGrams   Int
  kcal          Int
  protein       Int
  fat           Int
  carbs         Int
  imageUrl      String?
  isNew         Boolean     @default(false)
  active        Boolean     @default(true)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([subcategoryId])
}

model Promotion {
  id              String   @id @default(cuid())
  title           String
  description     String   @default("")
  imageUrl        String?
  discountPercent Int?
  startsAt        DateTime
  endsAt          DateTime
  active          Boolean  @default(true)
  productIds      String[]
}

// --- Chat (user ↔ operator) ---

model ChatRoom {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId   String?
  status    ChatRoomStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  messages ChatMessage[]

  @@index([userId])
  @@index([staffId])
  @@index([status])
}

enum ChatRoomStatus {
  OPEN
  ASSIGNED
  CLOSED
}

model ChatMessage {
  id         String    @id @default(cuid())
  roomId     String
  room       ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderType String    // "USER" | "OPERATOR"
  senderId   String
  text       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([roomId])
  @@index([createdAt])
}

// --- Call Queue (LiveKit voice calls) ---

model CallQueue {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomName  String   @unique
  status    CallStatus @default(QUEUED)
  position  Int?
  createdAt DateTime @default(now())
  endedAt   DateTime?

  @@index([userId])
  @@index([status])
}

enum CallStatus {
  QUEUED
  CONNECTING
  ACTIVE
  ENDED
}

// --- Push Tokens (Mobile) ---

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  platform  String   // "android" | "ios"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId])
}

// --- Orders ---

model Order {
  id             String        @id @default(cuid())
  number         Int           @unique @default(autoincrement())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  status         OrderStatus   @default(NEW)
  deliveryMode   DeliveryMode
  paymentMethod  PaymentMethod
  customerName   String
  customerPhone  String
  customerEmail  String?
  address        String?
  desiredTime    String?
  comment        String?
  itemsTotal     Int
  deliveryCost   Int
  total          Int
  courierId      String?
  courier        StaffUser?    @relation("CourierAssignment", fields: [courierId], references: [id], onDelete: SetNull)
  assignedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items      OrderItem[]
  statusLogs OrderStatusLog[]

  @@index([userId])
  @@index([status])
  @@index([courierId])
}

model OrderItem {
  id            String @id @default(cuid())
  orderId       String
  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  nameSnapshot  String
  priceSnapshot Int
  qty           Int

  @@index([orderId])
}

model OrderStatusLog {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  staffUserId String?
  staffUser   StaffUser?  @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@index([orderId])
}

// --- Preorder (large / scheduled orders) ---

model Preorder {
  id            String         @id @default(cuid())
  userId        String?
  status        PreorderStatus @default(NEW)
  customerName  String
  customerPhone String
  customerEmail String?
  desiredDate   DateTime
  guestCount    Int            @default(1)
  comment       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([desiredDate])
}

enum PreorderStatus {
  NEW
  CONFIRMED
  CANCELLED
}
